{
  "name": "agendamaster-ai",
  "private": true,
  "version": "1.0.8",
  "description": "Gerenciador e Editor de Agendas Personalizadas",
  "author": "Luiza Lacerda",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"vite\" \"ELECTRON_DEV_URL=http://localhost:3000 electron .\"",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.agendamaster.app",
    "productName": "Agenda Master",
    "publish": [
      {
        "provider": "github",
        "owner": "luizalacerdapapelaria-hue",
        "repo": "AGENDAMASTER"
      }
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Agenda Master",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@supabase/supabase-js": "^2.106.1",
    "@use-gesture/react": "^10.3.1",
    "electron-updater": "^6.8.9",
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "2.5.1",
    "lucide-react": "^0.562.0",
    "opentype.js": "^2.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
